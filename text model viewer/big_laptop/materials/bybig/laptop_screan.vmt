"VertexlitGeneric"
{
	"$basetexture" "bybig/laptop_screan"
	"$alphatest" 1
	
	"$allowalphatocoverage" 1
	
    "$color2" "[0.5 0.5 0.5]"
    
    "$translucent" "1"

    "$phong" "1"
    "$phongboost" "10"
    "$phongfresnelranges" "[1 1 1]"
    "$PhongDisableHalfLambert" ""

	"$emissiveBlendEnabled" "1"
	"$emissiveBlendTexture" 				"bybig/laptop_screan" // DOIT être une vraie texture !
	"$emissiveBlendBaseTexture"				"bybig/laptop_screan"
	"$emissiveBlendFlowTexture" 			"bybig/laptop_screan"
	"$emissiveBlendStrength" "1"
	"$emissiveBlendScrollVector" "[0.1 0]"

	"Proxies"
    {
        "UniformNoise"
        {
            "resultVar" "$emissiveBlendTint"
            "minval" 8
            "maxval" 12
        }
    }	
}

